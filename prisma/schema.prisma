generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Category {
  TINTO
  BLANCO
  ROSADO
  NARANJO
  ESPUMANTE
}

enum Role {
  ADMIN1
  ADMIN2
}

enum DrinkCategory {
  VERMUTH
  CLASICO
  AUTOR
  WHISKY
  CERVEZA
  SIN_ALCOHOL
  CAFETERIA
}

enum DishCategory {
  FRIO
  CALIENTE
  POSTRE
}

model Drink {
  id          Int           @id @default(autoincrement())
  name        String
  category    DrinkCategory
  description String?
  price       Int?
  imageUrl    String?
  available   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([available])
}

model Dish {
  id          Int          @id @default(autoincrement())
  name        String
  category    DishCategory
  subSection  String?
  description String?
  price       Int?
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@index([available])
}

model Wine {
  id          Int      @id @default(autoincrement())
  name        String
  winery      String
  category    Category
  varietal    String?
  zone        String
  subZone     String?
  vintage     Int?
  alcohol     Float?
  aging       String?
  servingTemp String?
  pairing     String?
  tastingNote String?
  price       Int?
  cost        Int?
  stock       Int      @default(1)
  fichaUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]

  @@index([category])
  @@index([zone])
  @@index([varietal])
  @@index([available])
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(ADMIN2)

  sales        Sale[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  wineId    Int
  wine      Wine     @relation(fields: [wineId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  quantity  Int      @default(1)
  unitPrice Int?
  total     Int?
  createdAt DateTime @default(now())

  @@index([wineId])
  @@index([userId])
  @@index([createdAt])
}

model ValuationSnapshot {
  id               Int      @id @default(autoincrement())
  takenAt          DateTime @default(now())
  totalUnits       Int
  totalCostValue   Int
  totalPriceValue  Int
  byCategoryJson   String
  byZoneJson       String
  byWineryJson     String
  wineCount        Int

  @@index([takenAt])
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?
  birthDate    DateTime?
  visits       Int           @default(0)
  firstVisit   DateTime?
  lastVisit    DateTime?
  noShowCount  Int           @default(0)
  blacklisted  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  reservations Reservation[]

  @@index([phone])
}

model Reservation {
  id           Int       @id @default(autoincrement())
  date         DateTime
  time         String
  guests       Int
  tables       String
  floor        String
  returning    Boolean   @default(false)
  completed    Boolean   @default(false)
  noShow       Boolean   @default(false)
  feedbackSent Boolean   @default(false)
  cancelToken  String?   @unique
  customerId   Int
  customer     Customer  @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  feedback     Feedback?

  @@index([date])
  @@index([customerId])
  @@index([completed])
  @@index([noShow])
  @@index([cancelToken])
}

model Feedback {
  id              Int         @id @default(autoincrement())
  reservationId   Int         @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  customerName    String
  reservationDate DateTime
  rating          Int?
  comment         String?
  createdAt       DateTime    @default(now())

  @@index([reservationId])
}

model TableBlock {
  id        Int      @id @default(autoincrement())
  date      DateTime
  time      String?
  tables    String
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model WaitingList {
  id        Int      @id @default(autoincrement())
  date      DateTime
  guests    Int
  nombre    String
  apellido  String
  telefono  String
  birthDate DateTime?
  email     String?
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([date])
  @@index([notified])
}
